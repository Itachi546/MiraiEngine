{
  "name": "gltf_graph",
  "passes": [
    {
      "name": "deferred_pass",
      "enabled": true,
      "outputs": [
        {
          "type": "attachment",
          "name": "gbuffer_color",
          "format": "B8G8R8A8_UNORM",
          "resolution": [
            1920,
            1080
          ],
          "op": "LOAD_OP_CLEAR"
        },
        {
          "type": "attachment",
          "name": "gbuffer_normal",
          "format": "R16G16B16A16_SFLOAT",
          "resolution": [
            1920,
            1080
          ],
          "op": "LOAD_OP_CLEAR"
        },
        {
          "type": "attachment",
          "name": "gbuffer_emissive",
          "format": "B8G8R8A8_UNORM",
          "resolution": [
            1920,
            1080
          ],
          "op": "LOAD_OP_CLEAR"
        },
        {
          "type": "attachment",
          "name": "gbuffer_velocity",
          "format": "R16G16_SFLOAT",
          "resolution": [
            1920,
            1080
          ],
          "op": "LOAD_OP_CLEAR",
          "clear_color": [
            0,
            0,
            0,
            0
          ]
        },
        {
          "type": "attachment",
          "name": "gbuffer_depth",
          "format": "D32_SFLOAT",
          "resolution": [
            1920,
            1080
          ],
          "op": "LOAD_OP_CLEAR"
        }
      ]
    },
    {
      "name": "directional_shadow_pass",
      "enabled": true,
      "outputs": [
        {
          "type": "attachment",
          "name": "cascaded_shadow_map",
          "format": "D16_UNORM",
          "resolution": [
            4096,
            4096
          ],
          "op": "LOAD_OP_CLEAR"
        }
      ]
    },
    {
      "name": "rt_directional_shadow_pass",
      "enabled": true,
      "type": "compute",
      "inputs": [
        {
          "type": "texture",
          "name": "gbuffer_depth"
        }
      ],
      "outputs": [
        {
          "type": "attachment",
          "name": "rt_directional_shadow_map",
          "format": "R8_UNORM",
          "resolution": [
            1920,
            1080
          ],
          "op": "LOAD_OP_CLEAR"
        }
      ]
    },
    {
      "name": "ssao_pass",
      "type": "compute",
      "enabled": true,
      "inputs": [
        {
          "type": "texture",
          "name": "gbuffer_depth"
        }
      ],
      "outputs": [
        {
          "type": "attachment",
          "name": "ssao_texture",
          "format": "R16_SFLOAT",
          "resolution": [
            960,
            540
          ],
          "op": "LOAD_OP_CLEAR"
        }
      ]
    },
    {
      "name": "deferred_lighting_pass",
      "enabled": true,
      "inputs": [
        {
          "type": "texture",
          "name": "gbuffer_color"
        },
        {
          "type": "texture",
          "name": "gbuffer_depth"
        },
        {
          "type": "texture",
          "name": "gbuffer_normal"
        },
        {
          "type": "texture",
          "name": "gbuffer_emissive"
        },
        {
          "type": "texture",
          "name": "ssao_texture"
        },
        {
          "type": "texture",
          "name": "rt_directional_shadow_map"
        },
        {
          "type": "texture",
          "name": "gbuffer_velocity"
        },
        {
          "type": "texture",
          "name": "cascaded_shadow_map"
        }
      ],
      "outputs": [
        {
          "type": "attachment",
          "name": "gbuffer_lighting",
          "format": "R16G16B16A16_SFLOAT",
          "resolution": [
            1920,
            1080
          ],
          "op": "LOAD_OP_CLEAR"
        }
      ]
    },
    {
      "name": "overlay3D",
      "enabled": true,
      "inputs": [
        {
          "type": "attachment",
          "name": "gbuffer_lighting"
        },
        {
          "type": "attachment",
          "name": "gbuffer_depth"
        }
      ],
      "outputs": [
        {
          "type": "reference",
          "name": "gbuffer_lighting"
        }
      ]
    },
    {
      "name": "deferred_transparent_pass",
      "enabled": true,
      "inputs": [
        {
          "type": "attachment",
          "name": "gbuffer_lighting"
        },
        {
          "type": "attachment",
          "name": "gbuffer_depth"
        }
      ],
      "outputs": [
        {
          "type": "reference",
          "name": "gbuffer_lighting"
        }
      ]
    },
    {
      "name": "taa_resolve_pass",
      "type": "compute",
      "inputs": [
        {
          "type": "texture",
          "name": "gbuffer_lighting"
        },
        {
          "type": "texture",
          "name": "gbuffer_depth"
        },
        {
          "type": "texture",
          "name": "gbuffer_velocity"
        }
      ],
      "outputs": [
        {
          "type": "texture",
          "name": "taa_output",
          "external": true
        }
      ]
    },
    {
      "name": "swapchain_copy",
      "enabled": true,
      "inputs": [
        {
          "type": "texture",
          "name": "taa_output"
        }
      ],
      "outputs": [
        {
          "type": "attachment",
          "name": "swapchain",
          "op": "LOAD_OP_CLEAR"
        }
      ]
    },
    {
      "name": "debug_pass",
      "enabled": true,
      "inputs": [
        {
          "type": "attachment",
          "name": "swapchain"
        }
      ],
      "outputs": [
        {
          "type": "reference",
          "name": "swapchain"
        }
      ]
    },
    {
      "name": "imgui_pass",
      "enabled": true,
      "inputs": [
        {
          "type": "attachment",
          "name": "swapchain"
        }
      ],
      "outputs": [
        {
          "type": "reference",
          "name": "swapchain"
        }
      ]
    }
  ]
}