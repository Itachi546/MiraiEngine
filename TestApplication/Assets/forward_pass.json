{
  "name": "forward_renderer_graph",
  "passes": [
    {
      "name": "depth_prepass",
      "enabled": true,
      "outputs": [
        {
          "type": "attachment",
          "name": "depth_attachment",
          "format": "D32_SFLOAT_S8_UINT",
          "resolution": [1920, 1080],
          "op": "LOAD_OP_CLEAR"
        }
      ]
    },
    {
      "name": "forward_pass",
      "enabled": true,
      "inputs": [
        {
          "type": "attachment",
          "name": "depth_attachment"
        }
      ],
      "outputs": [
        {
          "type": "attachment",
          "name": "color_attachment",
          "format": "B8G8R8A8_UNORM",
          "resolution": [1920, 1080],
          "op": "LOAD_OP_CLEAR"
        }
      ]
    },
    {
      "name": "overlay3D",
      "enabled": true,
      "inputs": [
        {
          "type": "attachment",
          "name": "color_attachment"
        },
        {
          "type": "attachment",
          "name": "depth_attachment"
        }
      ],
      "outputs": [
        {
          "type": "reference",
          "name": "color_attachment"
        }
      ]
    },
    {
      "name": "swapchain_copy",
      "enabled": true,
      "inputs": [
        {
          "type": "texture",
          "name": "color_attachment"
        }
      ],
      "outputs": [
        {
          "type": "attachment",
          "name": "swapchain",
          "op": "LOAD_OP_CLEAR"
        }
      ]
    },

    {
      "name": "debug_pass",
      "enabled": true,
      "inputs": [
        {
          "type": "attachment",
          "name": "swapchain"
        }
      ],
      "outputs": [
        {
          "type": "reference",
          "name": "swapchain"
        }
      ]
    }
  ]
}
